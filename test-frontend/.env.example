# Copy this file to .env and fill in the values for your environment.

# Backend API base URL
# Local dev: http://localhost:8000
# Production: your deployed backend URL
REACT_APP_API_URL=http://localhost:8000

# Google OAuth Client ID (Web application type) — public value, safe to
# expose in the frontend bundle. Must match GOOGLE_CLIENT_ID in the
# backend's .env for token verification to succeed.
REACT_APP_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Origin of the page allowed to embed this chat and send it an access token.
# Only used when the chat runs inside an iframe on the main web app.
# Local testing: http://localhost:4000 (the mock main app)
# Production:    the main web app's real origin, e.g. https://app.company.com
# NOTE: REACT_APP_* values are baked in at BUILD time — change this and rebuild.
REACT_APP_PARENT_ORIGIN=http://localhost:4000
